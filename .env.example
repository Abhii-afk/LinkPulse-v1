# Copy this file to .env for local development. Never commit .env.

# Application
APP_NAME=LinkPulse
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000

# Local PostgreSQL connection used by the host-running backend
POSTGRES_DB=linkpulse
POSTGRES_USER=linkpulse
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://linkpulse:replace-with-a-local-password@127.0.0.1:5432/linkpulse

# Local Redis connection used by the host-running backend
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379/0

# Frontend API origin (reserved for later frontend API integration)
VITE_API_BASE_URL=http://127.0.0.1:8000

# Base URL used when returning a created short link
PUBLIC_BASE_URL=http://127.0.0.1:8000

# Reserved for later authentication work; do not use this placeholder in production.
JWT_SECRET=replace-with-a-local-secret-at-least-32-bytes
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
