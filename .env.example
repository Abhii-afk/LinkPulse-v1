# Copy this file to .env for local development. Never commit .env.
#
# Every variable below is read by the backend. Values shown are the defaults
# that the application falls back to when the variable is absent, except for
# the ones marked REQUIRED, which have no safe default.

# --- Application -----------------------------------------------------------
APP_NAME=LinkPulse
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
# Port the frontend container publishes on the host.
FRONTEND_PORT=5173

# --- PostgreSQL ------------------------------------------------------------
# REQUIRED. The password for the local database. docker compose refuses to
# start without it, and the backend uses it to build DATABASE_URL.
# The value below is a PLACEHOLDER that is published in this repository.
# Replace it with a generated value, for example:
#   python -c "import secrets; print(secrets.token_urlsafe(18))"
POSTGRES_DB=linkpulse
POSTGRES_USER=linkpulse
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_PORT=5432
# Connection string used when the backend runs on the host. Inside the
# compose network the api and worker services override this with the "db"
# hostname, so the value below only matters for host-run processes.
DATABASE_URL=postgresql+asyncpg://linkpulse:replace-with-a-local-password@127.0.0.1:5432/linkpulse

# --- Redis -----------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Host-run processes use this URL. The compose api and worker services
# override it with redis://redis:6379/0.
REDIS_URL=redis://127.0.0.1:6379/0

# --- Frontend --------------------------------------------------------------
# Origin of the API that the browser calls. It is baked into the frontend
# bundle at build time, so it has to be correct when the image is built.
VITE_API_BASE_URL=http://127.0.0.1:8000
# Browser origins that may call the API. The front end runs on its own
# origin, so the browser asks the API for permission before every call.
# Without these origins the request is blocked before it leaves the browser.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# --- Public URLs -----------------------------------------------------------
# Base URL used when returning a created short link, and used to decide
# whether cookies are marked Secure. Use https:// in a real deployment.
PUBLIC_BASE_URL=http://127.0.0.1:8000

# --- Authentication --------------------------------------------------------
# REQUIRED. At least 24 characters. The service refuses to start otherwise
# and PyJWT recommends 32 bytes or more.
# The value below is a PLACEHOLDER that is published in this repository.
# Replace it with a generated value, for example:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=replace-with-a-local-secret-at-least-32-bytes
# Only HS256, HS384 and HS512 are accepted.
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
# Signing key for the short-lived cookie issued after a link password is
# solved. Leave blank to reuse JWT_SECRET.
LINK_SESSION_SECRET=
# How long a solved link password stays unlocked, in seconds.
LINK_SESSION_TTL_SECONDS=900

# --- Rate limiting ---------------------------------------------------------
# Maximum link creation calls per minute per client IP (BLUEPRINT section 12).
RATE_LIMIT_LINK_CREATION_PER_MINUTE=30
# Length of the sliding window in seconds.
RATE_LIMIT_WINDOW_SECONDS=60
# Maximum link password attempts per minute per client IP and short code.
RATE_LIMIT_PASSWORD_ATTEMPTS_PER_MINUTE=10

# --- Analytics worker ------------------------------------------------------
ANALYTICS_STREAM_NAME=stream:clicks
ANALYTICS_CONSUMER_GROUP=click_group
# Leave blank to generate a host/process-specific consumer name.
ANALYTICS_CONSUMER_NAME=
# Number of click events written to PostgreSQL per statement.
ANALYTICS_BATCH_SIZE=100
# How long the worker blocks waiting for new stream entries, in milliseconds.
ANALYTICS_BLOCK_MS=2000
# How long a pending message must be idle before another worker claims it.
ANALYTICS_CLAIM_MIN_IDLE_MS=60000

# --- Geolocation -----------------------------------------------------------
# Optional local MaxMind GeoLite2-City database. No external API is used.
GEOLITE2_CITY_DB_PATH=
GEOIP_MOCK_COUNTRY_CODE=XX
GEOIP_MOCK_CITY=Mock City
